{
  "name": "@workspace/supabase",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "gen:types": "dotenv -e ../../.env -- sh -c 'supabase gen types typescript --db-url \"$SUPABASE_DB_URL\" --schema public > src/database.types.ts' && prettier --write src/database.types.ts"
  },
  "exports": {
    "./client": "./src/client.ts",
    "./proxy": "./src/proxy.ts",
    "./roles": "./src/roles.ts",
    "./server": "./src/server.ts",
    "./types": "./src/database.types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3"
  },
  "peerDependencies": {
    "next": "^16"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10",
    "next": "16.4.0",
    "typescript": "^5"
  }
}
